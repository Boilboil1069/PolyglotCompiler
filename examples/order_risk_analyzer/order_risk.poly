// Data-driven order authorization application.
// One polyc invocation owns source discovery, four vendored-package manifests,
// four language frontends, native file runtime injection, and final linking.

IMPORT cpp::pricing_engine;
// Every language has a project-vendored package dependency. polyc resolves the
// manifests below: C++ receives a declared include root, while Python/Rust/Go
// receive declared source units before signature extraction and compilation.
// No shell-level -I flag, language package manager, or downloaded toolchain is
// involved.
IMPORT cpp PACKAGE order_policy >= 1.0;
IMPORT python::fraud_engine;
IMPORT python PACKAGE fraud_policy >= 1.0;
IMPORT rust::fulfillment_engine;
IMPORT rust PACKAGE fulfillment_policy >= 1.0;
IMPORT go::logistics_engine;
IMPORT go PACKAGE logistics_policy >= 1.0;

FUNC evaluate_order(
    unit_price: INT,
    quantity: INT,
    recent_orders: INT,
    failed_payments: INT,
    available_units: INT,
    delivery_zone: INT
) -> INT {
    // C++ free-function rules remain independently auditable.
    LET subtotal = CALL(cpp, pricing_engine::pricing_subtotal, unit_price, quantity);
    LET discount = CALL(cpp, pricing_engine::pricing_discount, subtotal, quantity, 2);
    LET shipping_fee = delivery_zone + 8;
    LET payable = CALL(cpp, pricing_engine::pricing_payable, subtotal, discount, shipping_fee);

    // The same result must be reproduced by the vendored C++ class package.
    // Its wrapper constructs OrderPricingSession, mutates/reads four fields,
    // invokes four instance methods, and runs the destructor before returning.
    LET object_payable = CALL(
        cpp, pricing_engine::pricing_session_payable, unit_price, quantity, delivery_zone
    );
    IF object_payable != payable {
        RETURN 60;
    }

    // Python: derive independent velocity and amount features, then a band.
    LET velocity_points = CALL(
        python, fraud_engine::fraud_velocity_points, recent_orders, failed_payments, 1
    );
    LET amount_points = CALL(
        python, fraud_engine::fraud_amount_points, payable, 28, 0
    );
    LET risk_band = CALL(
        python, fraud_engine::fraud_risk_band, velocity_points, amount_points, failed_payments
    );
    LET object_risk_band = CALL(
        python, fraud_engine::fraud_session_band, velocity_points, amount_points, failed_payments
    );
    IF object_risk_band != risk_band {
        RETURN 61;
    }

    // Rust: reserve stock, authorize payment, and combine both gates.
    LET reserved = CALL(
        rust, fulfillment_engine::inventory_reservable, quantity, available_units, 5
    );
    LET payment_status = CALL(
        rust, fulfillment_engine::payment_authorization, risk_band, payable, failed_payments
    );
    LET fulfillment_status = CALL(
        rust, fulfillment_engine::fulfillment_gate, quantity, reserved, payment_status
    );
    LET object_fulfillment_status = CALL(
        rust, fulfillment_engine::fulfillment_session_gate, quantity, reserved, payment_status
    );
    IF object_fulfillment_status != fulfillment_status {
        RETURN 62;
    }

    // Go: calculate delivery capacity and normalize the final decision.
    LET base_days = CALL(
        go, logistics_engine::logistics_base_days, delivery_zone, quantity, reserved
    );
    LET capacity_delay = CALL(
        go, logistics_engine::logistics_capacity_delay, quantity, 4, 1
    );
    LET eta_days = base_days + capacity_delay;
    LET decision = CALL(
        go, logistics_engine::logistics_decision, fulfillment_status, risk_band, eta_days
    );
    LET object_decision = CALL(
        go, logistics_engine::logistics_session_decision,
        fulfillment_status, risk_band, eta_days
    );
    IF object_decision != decision {
        RETURN 63;
    }
    RETURN decision;
}

// Write the same bytes to stdout and the caller-selected result file.
FUNC emit_order(out: INT, order_id: INT, decision: INT) -> INT {
    IF file_write_text(1, "ORDER ") < 0 { RETURN 227; }
    IF file_write_text(out, "ORDER ") < 0 { RETURN 227; }
    IF file_write_int(1, order_id, 32) < 0 { RETURN 227; }
    IF file_write_int(out, order_id, 32) < 0 { RETURN 227; }
    IF file_write_int(1, decision, 10) < 0 { RETURN 227; }
    IF file_write_int(out, decision, 10) < 0 { RETURN 227; }
    RETURN 0;
}

FUNC emit_summary(out: INT, stats: INT) -> INT {
    IF file_write_text(1, "SUMMARY ") < 0 { RETURN 227; }
    IF file_write_text(out, "SUMMARY ") < 0 { RETURN 227; }
    VAR index = 0;
    WHILE index < 6 {
        VAR delimiter = 32;
        IF index == 5 { delimiter = 10; }
        LET value = array_get(stats, index, -1);
        IF file_write_int(1, value, delimiter) < 0 { RETURN 227; }
        IF file_write_int(out, value, delimiter) < 0 { RETURN 227; }
        index = index + 1;
    }
    RETURN 0;
}

FUNC process_order_stream(fd: INT, out: INT, stats: INT) -> INT {
    // The integer reader skips header text and delimiters. A partial record
    // reaches the sentinel and is rejected before calling any business rule.
    LET eof = -999999;
    LET order_id = file_next_int(fd, eof);
    IF order_id == eof {
        IF array_get(stats, 0, 0) == 0 { RETURN 222; }
        RETURN emit_summary(out, stats);
    }
    LET unit_price = file_next_int(fd, eof);
    LET quantity = file_next_int(fd, eof);
    LET recent_orders = file_next_int(fd, eof);
    LET failed_payments = file_next_int(fd, eof);
    LET available_units = file_next_int(fd, eof);
    LET delivery_zone = file_next_int(fd, eof);
    LET expected_decision = file_next_int(fd, eof);
    IF order_id <= 0 { RETURN 222; }
    IF unit_price <= 0 { RETURN 222; }
    IF unit_price > 1000000 { RETURN 222; }
    IF quantity <= 0 { RETURN 222; }
    IF quantity > 1000 { RETURN 222; }
    IF recent_orders < 0 { RETURN 222; }
    IF recent_orders > 1000000 { RETURN 222; }
    IF failed_payments < 0 { RETURN 222; }
    IF failed_payments > 1000 { RETURN 222; }
    IF available_units < 0 { RETURN 222; }
    IF available_units > 1000000 { RETURN 222; }
    IF delivery_zone < 1 { RETURN 222; }
    IF delivery_zone > 3 { RETURN 222; }
    IF expected_decision < 0 { RETURN 222; }

    LET actual = evaluate_order(unit_price, quantity, recent_orders,
                                failed_payments, available_units, delivery_zone);
    IF actual != expected_decision { RETURN 225; }
    VAR category = 0;
    IF actual >= 100 { category = 1; }
    IF actual == 20 { category = 2; }
    IF actual == 40 { category = 3; }
    IF actual == 30 { category = 4; }
    IF category == 0 { RETURN 226; }
    LET write_status = emit_order(out, order_id, actual);
    IF write_status != 0 { RETURN write_status; }
    array_set(stats, 0, array_get(stats, 0, 0) + 1);
    array_set(stats, category, array_get(stats, category, 0) + 1);
    array_set(stats, 5, array_get(stats, 5, 0) + actual);
    RETURN process_order_stream(fd, out, stats);
}

FUNC main() -> INT {
    VAR fd = -1;
    IF args_count() >= 2 {
        fd = file_open_ints(arg_text(1));
    } ELSE {
        fd = file_open_ints("data/orders.csv");
    }
    IF fd < 0 { RETURN 220; }
    VAR out = -1;
    IF args_count() >= 3 {
        out = file_open_write(arg_text(2));
    } ELSE {
        out = file_open_write("order-results.txt");
    }
    IF out < 0 {
        file_close(fd);
        RETURN 227;
    }
    LET stats = array_new(6);
    IF stats == 0 {
        file_close(fd);
        file_close(out);
        RETURN 228;
    }
    LET status = process_order_stream(fd, out, stats);
    array_free(stats);
    LET close_input = file_close(fd);
    LET close_output = file_close(out);
    IF close_input != 0 { RETURN 221; }
    IF close_output != 0 { RETURN 221; }
    RETURN status;
}
